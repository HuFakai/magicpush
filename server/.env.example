# 服务器配置
PORT=3000
NODE_ENV=development

# JWT配置
# 留空时首次启动会自动生成并保存；生产环境也可设置至少 32 字节的随机值
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 数据库配置
DB_PATH=./data/push_service.db

# 日志级别
LOG_LEVEL=info

# 默认禁止渠道访问本机/内网地址，防止 SSRF。
# 仅在单管理员、需要连接可信局域网自托管服务时显式开启。
ALLOW_PRIVATE_OUTBOUND_URLS=false

# 对外访问 MagicPush 的基础地址。上传小爱音箱音频时用于生成可播放的在线 URL。
# 标准 HTTP 部署可留空自动识别；使用 HTTPS 域名或多层反向代理时建议显式填写。
PUBLIC_BASE_URL=

# 小爱音箱上传音频配置。目录默认位于持久化 data 卷中，单文件默认最大 20MB。
MISOUND_AUDIO_DIR=./data/uploads/misound
MISOUND_AUDIO_MAX_SIZE_MB=20
